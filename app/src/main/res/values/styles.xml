<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark "Frame" splash as the window background (shows instantly while the page loads) and no open/close animations -->
    <style name="FrameTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
